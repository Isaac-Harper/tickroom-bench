# Copy to .env.local for local work.

# A real TCP Redis connection. A REST-style Redis API cannot SUBSCRIBE, and the
# ticker-to-socket fan-out is pub/sub, so an HTTP Redis product will not work as
# the bus however good it is at ordinary commands.
REDIS_URL=redis://127.0.0.1:6399

# HMAC key behind session tokens and ticker spawn tokens. Required: the app
# refuses to build or start in production without it, because a missing secret
# would otherwise degrade into every token being forgeable with a value printed
# in the library's source. Any value works locally.
SESSION_SECRET=dev-secret-do-not-ship

# Only needed when Vercel Deployment Protection is ON for this project. See
# lib/tickerUrl.ts for the silent failure it fixes.
# VERCEL_AUTOMATION_BYPASS_SECRET=
